---
/** Previous and next case study, by `order`. */
import type { CollectionEntry } from 'astro:content';
import Icon from '../ui/Icon.astro';

interface Props {
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}
const { prev, next } = Astro.props;
---

<nav class="border-line grid gap-4 border-t pt-8 sm:grid-cols-2" aria-label="More case studies">
  {prev ? (
    <a
      href={`/projects/${prev.id}`}
      class="group border-line bg-surface hover:border-line-strong rounded-md border p-5 transition-colors duration-(--dur-fast)"
    >
      <span class="text-mono-meta text-fg-faint inline-flex items-center gap-1 font-mono">
        <Icon name="lucide:arrow-left" size={14} /> previous
      </span>
      <span class="text-fg group-hover:text-accent mt-2 block font-medium">{prev.data.title}</span>
    </a>
  ) : (
    <span />
  )}
  {next && (
    <a
      href={`/projects/${next.id}`}
      class="group border-line bg-surface hover:border-line-strong rounded-md border p-5 text-right transition-colors duration-(--dur-fast)"
    >
      <span class="text-mono-meta text-fg-faint inline-flex items-center gap-1 font-mono">
        next <Icon name="lucide:arrow-right" size={14} />
      </span>
      <span class="text-fg group-hover:text-accent mt-2 block font-medium">{next.data.title}</span>
    </a>
  )}
</nav>
