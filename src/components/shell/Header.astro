---
/**
 * Site header. Persisted across view transitions so it never re-renders on navigation.
 * Below md the links collapse into a menu button that opens the MobileNav dialog.
 */
import { site } from '../../data/site';
import ThemeToggle from './ThemeToggle.astro';
import MobileNav from './MobileNav.astro';
import Icon from '../ui/Icon.astro';
import Wordmark from './Wordmark.astro';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current === href || current.startsWith(`${href}/`);
---

<header
  class="border-line bg-canvas/85 sticky top-0 z-40 border-b backdrop-blur"
  transition:persist
  transition:name="site-header"
>
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a
      href="/"
      class="text-fg hover:text-accent rounded-xs font-mono text-[15px] font-medium tracking-tight"
    >
      <Wordmark />
    </a>

    <nav class="hidden md:block" aria-label="Primary">
      <ul class="flex items-center gap-1">
        {site.nav.map((link) => {
          const active = isActive(link.href);
          return (
            <li>
              <a
                href={link.href}
                aria-current={active ? 'page' : undefined}
                data-nav-link
                class="text-small text-fg-muted hover:text-fg relative inline-flex h-16 items-center px-3 font-medium transition-colors duration-(--dur-fast) after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:rounded-full after:bg-transparent after:transition-[background-color] after:duration-(--dur-fast) hover:after:bg-line-strong aria-[current=page]:text-fg aria-[current=page]:after:bg-accent"
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <ThemeToggle />
      <button
        type="button"
        class="text-fg-muted hover:text-accent hover:bg-accent-soft inline-flex size-10 items-center justify-center rounded-sm transition-[color,background-color] duration-(--dur-fast) md:hidden"
        data-mobile-nav-open
        aria-haspopup="dialog"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <Icon name="lucide:menu" size={22} />
      </button>
    </div>
  </div>

  <MobileNav current={current} />
</header>

<script>
  // The header persists across view transitions, so the active link must follow the URL by hand.
  const isActive = (href: string, path: string) =>
    href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

  const sync = () => {
    const path = location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
      const href = link.getAttribute('href') ?? '';
      if (isActive(href, path)) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  };

  sync();
  document.addEventListener('astro:page-load', sync);
</script>
