---
/**
 * Structured data as one @graph. The layout always emits the site-level nodes
 * (WebSite, Organization, ProfessionalService); pages add their own through `nodes`.
 * The Person node is shared so pages can reference it by id.
 */
import { site, skillGroups, jsonLdIds as ids } from '../../data/site';

interface Props {
  nodes?: Record<string, unknown>[];
}
const { nodes = [] } = Astro.props;

const base = site.url.replace(/\/$/, '');
const knowsAbout = skillGroups.flatMap((group) => group.skills).slice(0, 24);

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': ids.website,
    url: `${base}/`,
    name: site.name,
    description: site.description,
    publisher: { '@id': ids.organization },
  },
  {
    '@type': 'Organization',
    '@id': ids.organization,
    name: site.company,
    url: `${base}/`,
    founder: { '@id': ids.person },
  },
  {
    '@type': 'Person',
    '@id': ids.person,
    name: site.name,
    jobTitle: site.role,
    url: `${base}/about`,
    worksFor: { '@id': ids.organization },
    knowsAbout,
    sameAs: [site.social.linkedin, site.social.github],
  },
  {
    '@type': 'ProfessionalService',
    '@id': ids.service,
    name: `${site.name}, ${site.role}`,
    url: `${base}/`,
    description: site.description,
    provider: { '@id': ids.organization },
    areaServed: 'Worldwide',
    serviceType: [
      'Cloud infrastructure design and support (AWS, Azure)',
      'Linux platform engineering and automation',
      'Kubernetes and container platforms',
      'Posit Team deployment and support',
    ],
  },
];

// Page nodes with the same @id as a site node replace it (the About page sends a fuller Person).
for (const node of nodes) {
  const index = graph.findIndex((existing) => existing['@id'] && existing['@id'] === node['@id']);
  if (index === -1) graph.push(node);
  else graph[index] = { ...graph[index], ...node };
}

const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<script is:inline type="application/ld+json" set:html={json}></script>
