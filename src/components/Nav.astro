---
type NavLink = { href: string; label: string };

const links: NavLink[] = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' },
  { href: '/book', label: 'Book a Call' },
  { href: '/contact', label: 'Contact' },
];
const current: string = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-[#071a2d]/85 backdrop-blur">
  <nav
    class="mx-auto flex max-w-5xl flex-col items-start gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-6 sm:py-4"
    aria-label="Primary"
  >
    <a href="/" class="font-mono text-sm font-medium tracking-tight text-slate-100 hover:text-cyan-300 sm:text-base">
      <span class="text-cyan-300">&gt;</span> Jimmy speaks tech<span class="ml-1 animate-pulse text-cyan-300">_</span>
    </a>
    <ul class="flex w-full flex-wrap gap-x-4 gap-y-1 text-xs font-medium sm:w-auto sm:gap-6 sm:text-sm">
      {links.map((link) => {
        const isExternal = link.href.startsWith('http');
        const isActive = !isExternal && (current === link.href || (link.href !== '/' && current.startsWith(link.href)));
        return (
          <li>
            <a
              href={link.href}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'transition-colors hover:text-cyan-400',
                isActive ? 'text-cyan-400' : 'text-slate-300',
              ]}
            >
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
