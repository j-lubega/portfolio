---
import { profile } from '../data/site';
---

<footer class="border-t border-line py-10">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-3 px-6 text-center text-sm text-fg-faint">
    <div class="flex gap-6">
      <a
        href={profile.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent"
      >
        LinkedIn
      </a>
      <a
        href={profile.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent"
      >
        GitHub
      </a>
    </div>
    <p>© 2026 purenest360 llc - All rights reserved.</p>
    <button
      type="button"
      data-theme-reset
      hidden
      class="text-mono-meta hover:text-accent rounded-xs font-mono underline-offset-4 hover:underline"
    >
      Reset theme to automatic
    </button>
  </div>
</footer>

<script>
  import { clearManualTheme, getManualTheme } from '../scripts/theme';

  const buttons = () => document.querySelectorAll<HTMLButtonElement>('[data-theme-reset]');
  const sync = () => buttons().forEach((button) => (button.hidden = getManualTheme() === null));
  const init = () => {
    buttons().forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = 'true';
      button.addEventListener('click', clearManualTheme);
    });
    sync();
  };

  init();
  document.addEventListener('astro:page-load', init);
  window.addEventListener('jl:themechange', sync);
</script>
