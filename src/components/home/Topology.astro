---
/**
 * Systems topology: six labeled nodes with edges, and slow "packet" pulses that travel
 * the edges. Static SVG rendered by Astro; the pulses are SMIL <animateMotion>, which
 * costs no JavaScript and is hidden under prefers-reduced-motion (the diagram stays).
 * Tokens drive every color, so it flips with the theme like everything else.
 */
import Icon from '../ui/Icon.astro';

type Node = { id: string; label: string; icon: string; x: number; y: number };
const H = 40;
// Box width from the mono label length (12px mono is about 7.3px per character) plus icon and padding.
const widthOf = (label: string) => Math.max(88, Math.round(44 + label.length * 7.3));
const nodes: Node[] = [
  { id: 'k8s', label: 'kubernetes', icon: 'simple-icons:kubernetes', x: 260, y: 200 },
  { id: 'aws', label: 'aws', icon: 'simple-icons:amazonwebservices', x: 100, y: 96 },
  { id: 'azure', label: 'azure', icon: 'lucide:cloud', x: 420, y: 96 },
  { id: 'obs', label: 'observability', icon: 'simple-icons:grafana', x: 424, y: 300 },
  { id: 'iac', label: 'terraform / ansible', icon: 'simple-icons:terraform', x: 260, y: 356 },
  { id: 'linux', label: 'linux', icon: 'simple-icons:linux', x: 96, y: 300 },
];
const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
const edges: [string, string, number][] = [
  ['k8s', 'aws', 9],
  ['k8s', 'azure', 11],
  ['k8s', 'obs', 8],
  ['k8s', 'iac', 10],
  ['k8s', 'linux', 12],
  ['iac', 'aws', 13],
  ['iac', 'azure', 14],
  ['linux', 'iac', 9.5],
];
const path = (a: string, b: string) => `M ${byId[a].x} ${byId[a].y} L ${byId[b].x} ${byId[b].y}`;
---

<svg
  class="topology h-auto w-full"
  viewBox="0 0 520 420"
  role="img"
  aria-labelledby="topology-title"
  fill="none"
>
  <title id="topology-title">Diagram: a Kubernetes platform connected to AWS, Azure, Linux, infrastructure as code and observability.</title>
  <defs>
    <pattern id="topology-grid" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r="1" class="fill-line-strong"></circle>
    </pattern>
  </defs>
  <rect width="520" height="420" fill="url(#topology-grid)" opacity="0.6"></rect>

  <g class="stroke-line-strong" stroke-width="1.25" stroke-linecap="round">
    {edges.map(([a, b], i) => (
      <path id={`topo-edge-${i}`} d={path(a, b)} />
    ))}
  </g>

  <g class="topology-pulses">
    {edges.map(([, , dur], i) => (
      <circle r="2.5" class="fill-accent">
        <animateMotion
          dur={`${dur}s`}
          begin={`${(i * 1.3) % 6}s`}
          repeatCount="indefinite"
          calcMode="linear"
        >
          <mpath href={`#topo-edge-${i}`} />
        </animateMotion>
      </circle>
    ))}
  </g>

  {nodes.map((n) => (
    <g transform={`translate(${n.x - widthOf(n.label) / 2} ${n.y - H / 2})`}>
      <rect
        width={widthOf(n.label)}
        height={H}
        rx="6"
        class:list={[
          'stroke-line-strong',
          n.id === 'k8s' ? 'fill-accent-soft stroke-accent' : 'fill-surface',
        ]}
        stroke-width="1"
      />
      <g transform="translate(12 12)" class="text-fg-muted">
        <Icon name={n.icon} size={16} />
      </g>
      <text x="36" y="24" class="fill-fg font-mono" font-size="12">
        {n.label}
      </text>
    </g>
  ))}
</svg>

<style>
  .topology text {
    font-family: var(--font-mono);
  }
  @media (prefers-reduced-motion: reduce) {
    .topology-pulses {
      display: none;
    }
  }
</style>
