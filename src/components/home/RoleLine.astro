---
/**
 * Terminal-style role line. Types two lines once (about 1.9 s total), then the cursor
 * blinks four times and stops. Pure CSS: the text is in the HTML, so it exists without
 * JavaScript, and the global reduced-motion rule collapses the animation to an instant reveal.
 * No aria-live: screen readers get the final text only.
 */
interface Props {
  lines: [string, string];
  class?: string;
}
const { lines, class: className } = Astro.props;
---

<p
  class:list={['role-line text-mono-meta text-fg-muted flex flex-col gap-1 font-mono', className]}
  style={`--n1: ${lines[0].length}; --n2: ${lines[1].length}`}
>
  <span class="role-line__row">
    <span class="text-accent" aria-hidden="true">
      $&nbsp;
    </span>
    <span class="role-line__text role-line__text--1">{lines[0]}</span>
  </span>
  <span class="role-line__row">
    <span class="text-accent" aria-hidden="true">
      &gt;&nbsp;
    </span>
    <span class="role-line__text role-line__text--2">{lines[1]}</span>
    <span class="role-line__cursor" aria-hidden="true"></span>
  </span>
</p>

<style>
  .role-line__row {
    display: flex;
    align-items: baseline;
    white-space: nowrap;
  }
  .role-line__text {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    max-width: 100%;
  }
  .role-line__text--1 {
    width: calc(var(--n1) * 1ch);
    animation: type-1 1.1s steps(var(--n1)) both;
  }
  .role-line__text--2 {
    width: calc(var(--n2) * 1ch);
    animation: type-2 0.8s steps(var(--n2)) 1.2s both;
  }
  .role-line__cursor {
    display: inline-block;
    width: 0.6ch;
    height: 1em;
    margin-left: 0.15ch;
    transform: translateY(0.15em);
    background: var(--color-accent);
    opacity: 0;
    /* Starts as the second line finishes typing (~2s), 4 blinks, done by 4.7s: comfortably under
       the 5s cutoff so it never reads as a stuck cursor. */
    animation: cursor-blink 0.7s steps(1) 1.9s 4;
  }
  @keyframes type-1 {
    from {
      width: 0;
    }
    to {
      width: calc(var(--n1) * 1ch);
    }
  }
  @keyframes type-2 {
    from {
      width: 0;
    }
    to {
      width: calc(var(--n2) * 1ch);
    }
  }
  @keyframes cursor-blink {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }
  /* Reduced motion: no typing at all, the finished text is simply there */
  @media (prefers-reduced-motion: reduce) {
    .role-line__text {
      width: auto;
      animation: none;
    }
    .role-line__cursor {
      display: none;
    }
  }
  /* Narrow viewports: let the finished line wrap instead of clipping */
  @media (max-width: 24rem) {
    .role-line__row,
    .role-line__text {
      white-space: normal;
    }
    .role-line__text {
      width: auto;
      animation: none;
    }
    .role-line__cursor {
      animation-delay: 0s;
    }
  }
</style>
