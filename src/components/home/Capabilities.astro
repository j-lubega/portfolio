---
/** "What I do": three alternating rows, each with an icon panel and a titled capability. */
import { capabilities } from '../../data/site';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Tag from '../ui/Tag.astro';
import Icon from '../ui/Icon.astro';
---

<Section labelledby="capabilities-title">
  <Container>
    <SectionHeader
      eyebrow="what I do"
      index="01"
      title="Platforms, end to end"
      id="capabilities-title"
    >
      Design, build, secure and support. The same person from the architecture document to the
      on-call handover.
    </SectionHeader>

    <ol data-reveal-group class="mt-14 flex flex-col gap-16 md:gap-20">
      {capabilities.map((cap, i) => (
        <li class="grid items-center gap-8 md:grid-cols-12 md:gap-12">
          <div
            class:list={[
              'md:col-span-5',
              i % 2 === 1 ? 'md:order-2 md:col-start-8' : 'md:col-start-1',
            ]}
          >
            <div class="border-line bg-surface relative overflow-hidden rounded-lg border p-6">
              <div class="text-mono-meta text-fg-faint flex items-center justify-between font-mono">
                <span>
                  {cap.index} / {cap.stack.length} tools
                </span>
                <Icon name={cap.icon} size={18} class="text-accent" />
              </div>
              <ul class="mt-6 grid grid-cols-3 gap-3">
                {cap.stack.map((item) => (
                  <li class="border-line bg-canvas flex flex-col items-center gap-2 rounded-md border px-2 py-4">
                    <Icon name={item.icon ?? 'lucide:cloud'} size={22} class="text-fg-muted" />
                    <span class="text-fg-muted text-center font-mono text-[11px] leading-tight">
                      {item.label}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div
            class:list={[
              'md:col-span-7',
              i % 2 === 1 ? 'md:order-1 md:col-start-1' : 'md:col-start-6',
            ]}
          >
            <p class="text-mono-label text-accent font-mono uppercase">
              <span aria-hidden="true">// </span>
              {cap.index}
            </p>
            <h3 class="text-h2 text-fg mt-3">{cap.title}</h3>
            <p class="text-lead text-fg-muted mt-4">{cap.summary}</p>
            <ul class="text-fg-muted mt-6 flex flex-col gap-3">
              {cap.bullets.map((bullet) => (
                <li class="flex gap-3">
                  <span
                    class="text-accent mt-2.5 size-1.5 shrink-0 rounded-full bg-current"
                    aria-hidden="true"
                  />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
            <ul class="mt-6 flex flex-wrap gap-2" aria-label={`${cap.title} stack`}>
              {cap.stack.map((item) => (
                <Tag element="li" icon={item.icon}>
                  {item.label}
                </Tag>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </Container>
</Section>
