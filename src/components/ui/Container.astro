---
/** Horizontal measure and gutters. Every section's content sits inside one of these. */
interface Props {
  size?: 'prose' | 'default' | 'wide';
  class?: string;
}
const { size = 'default', class: className } = Astro.props;
const widths = {
  prose: 'max-w-[65ch]',
  default: 'max-w-6xl',
  wide: 'max-w-7xl',
};
---

<div class:list={['mx-auto w-full px-5 sm:px-8', widths[size], className]}>
  <slot />
</div>
