---
/** A numeral with a label: "400+ / physical servers built". Tabular figures, mono. */
interface Props {
  value: string;
  label: string;
  class?: string;
}
const { value, label, class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-1', className]}>
  <span class="text-fg tabular font-mono text-3xl font-medium tracking-tight">{value}</span>
  <span class="text-mono-meta text-fg-faint font-mono">{label}</span>
</div>
