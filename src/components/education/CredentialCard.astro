---
/**
 * One certification. Badge image when the client has cleared it, otherwise the issuer glyph
 * (decorative) with the issuer named in text.
 */
import type { CollectionEntry } from 'astro:content';
import Icon from '../ui/Icon.astro';
import Card from '../ui/Card.astro';

interface Props {
  cert: CollectionEntry<'certifications'>;
}
const { cert } = Astro.props;
const { data } = cert;

const dates = [
  `issued ${data.issued === 'pending' ? 'pending' : data.issued}`,
  data.expires ? `expires ${data.expires}` : null,
]
  .filter(Boolean)
  .join(' · ');
---

<Card element="li" class="flex flex-col">
  <div class="flex items-start justify-between gap-4">
    <div class="border-line bg-canvas flex size-12 shrink-0 items-center justify-center rounded-md border">
      {data.badge ? (
        <img src={data.badge} alt={data.name} width="40" height="40" loading="lazy" />
      ) : (
        <Icon name={data.issuerIcon ?? 'lucide:award'} size={22} class="text-fg-muted" />
      )}
    </div>
  </div>
  <h3 class="text-h3 text-fg mt-5">{data.name}</h3>
  <p class="text-small text-fg-muted mt-1">
    {data.issuer}
    {data.level && <span class="text-fg-faint"> · {data.level}</span>}
  </p>
  <p class="text-mono-meta text-fg-faint tabular mt-4 font-mono">{dates}</p>
  {data.credentialId && (
    <p class="text-mono-meta text-fg-faint font-mono">id {data.credentialId}</p>
  )}
  {data.verifyUrl && (
    <a
      href={data.verifyUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-small hover:text-accent link-underline mt-3 inline-flex items-center gap-1 self-start rounded-xs"
    >
      Verify credential
      <Icon name="lucide:external-link" size={14} />
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  )}
</Card>
