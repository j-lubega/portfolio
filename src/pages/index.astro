---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import Capabilities from '../components/home/Capabilities.astro';
import BookACall from '../components/home/BookACall.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import CertStrip from '../components/home/CertStrip.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Technical Consultant and Platform Engineer"
  description={site.description}
  ogImage="/og/home.png"
  ogImageAlt="Jimmy Lubega, Technical Consultant and Platform Engineer. Cloud infrastructure, Linux, automation, Kubernetes."
>
  <Hero />
  <ProofStrip />
  <Capabilities />
  <BookACall />
  <SelectedWork />
  <CertStrip />
  <FinalCta />
</BaseLayout>
