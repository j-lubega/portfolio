---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, certifications } from '../data/profile';
import TechOrbit from '../components/TechOrbit';
---

<BaseLayout
  title="Technical Consultant for Posit, Cloud & Enterprise Platforms"
  description="Jimmy is a technical consultant and platform engineer who deploys and supports Posit Team for data science on AWS, Azure, GCP, and on premises, while troubleshooting enterprise applications."
>
  <section class="relative isolate overflow-hidden border-b border-white/10">
    <TechOrbit client:load />
    <div class="relative mx-auto max-w-6xl px-6 py-24 sm:py-32">
      <p class="font-mono text-sm uppercase tracking-[0.2em] text-cyan-300">JL · Technical consulting</p>
      <h1 class="font-display mt-5 max-w-4xl text-4xl font-semibold tracking-tight text-white sm:text-7xl">
        Infrastructure support, without the noise.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-sky-100/75">Cloud · Linux · Posit · Enterprise platforms</p>
      <p class="mt-7 max-w-2xl text-xl leading-relaxed text-slate-200">
      {profile.tagline}
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/book"
        class="rounded-md bg-cyan-300 px-5 py-3 text-sm font-semibold text-[#071a2d] transition hover:bg-white"
      >
        Book a technical call
      </a>
      <a
        href="/projects"
        class="rounded-md border border-white/25 px-5 py-3 text-sm font-semibold text-slate-100 transition hover:border-cyan-300 hover:text-cyan-200"
      >
        View Projects
      </a>
      </div>
    </div>
  </section>

  <section class="border-b border-white/10 bg-[#08294a] py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-cyan-300">What I help teams do</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">Clear support for critical systems.</h2>
        <p class="mt-5 leading-relaxed text-slate-300">Deploy. Support. Troubleshoot. Improve.</p>
      </div>
      <div class="mt-10 grid gap-px overflow-hidden border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
        <article class="bg-[#08294a] p-6">
          <p class="font-mono text-sm text-cyan-300">01 / DATA SCIENCE PLATFORMS</p>
          <h3 class="mt-5 text-xl font-semibold text-white">Deploy Posit Team anywhere</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">Deploy and support Posit Team for data science.</p>
          <p class="mt-5 text-xs text-sky-100/70">AWS · Azure · GCP · On premises</p>
        </article>
        <article class="bg-[#08294a] p-6">
          <p class="font-mono text-sm text-cyan-300">02 / PLATFORM OPERATIONS</p>
          <h3 class="mt-5 text-xl font-semibold text-white">Keep critical systems healthy</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">Support cloud, Linux, Kubernetes, and automation.</p>
          <p class="mt-5 text-xs text-sky-100/70">Reliable · secure · repeatable</p>
        </article>
        <article class="bg-[#08294a] p-6 sm:col-span-2 lg:col-span-1">
          <p class="font-mono text-sm text-cyan-300">03 / ENTERPRISE SUPPORT</p>
          <h3 class="mt-5 text-xl font-semibold text-white">Find the signal in the noise</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">Troubleshoot enterprise applications and production issues.</p>
          <p class="mt-5 text-xs text-sky-100/70">Diagnose · explain · improve</p>
        </article>
      </div>
    </div>
  </section>

  <section class="border-t border-white/10 bg-black/10 py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-cyan-300">Proof of practice</p>
          <h2 class="mt-2 text-2xl font-semibold text-white">Certifications</h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-slate-300">A practical blend of cloud architecture, secure operations, and container platforms.</p>
      </div>
      <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {certifications.map((cert, index) => (
          <li class="rounded-lg border border-white/10 bg-white/[0.05] px-4 py-3 text-sm text-slate-200">
            <span class="mr-3 font-mono text-cyan-300/70">0{index + 1}</span>
            {cert}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
