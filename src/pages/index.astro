---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, certifications } from '../data/site';
import TechOrbit from '../components/TechOrbit';
---

<BaseLayout
  title="Technical Consultant for Posit, Cloud & Enterprise Platforms"
  description="Jimmy is a technical consultant and platform engineer who deploys and supports Posit Team for data science on AWS, Azure, GCP, and on premises, while troubleshooting enterprise applications."
>
  <section class="relative isolate overflow-hidden border-b border-line">
    <TechOrbit client:load />
    <div class="relative mx-auto max-w-6xl px-6 py-24 sm:py-32">
      <p class="font-mono text-sm uppercase tracking-[0.2em] text-accent">
        JL · Technical consulting
      </p>
      <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-tight text-fg sm:text-7xl">
        Infrastructure support, without the noise.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-fg-muted">
        Cloud · Linux · Posit · Enterprise platforms
      </p>
      <p class="mt-7 max-w-2xl text-xl leading-relaxed text-fg">{profile.tagline}</p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/book"
          class="rounded-md bg-accent px-5 py-3 text-sm font-semibold text-accent-fg transition hover:bg-accent-hover"
        >
          Book a technical call
        </a>
        <a
          href="/projects"
          class="rounded-md border border-line-strong px-5 py-3 text-sm font-semibold text-fg transition hover:border-accent hover:text-accent"
        >
          View Projects
        </a>
      </div>
    </div>
  </section>

  <section class="border-b border-line bg-surface py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">What I help teams do</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
          Clear support for critical systems.
        </h2>
        <p class="mt-5 leading-relaxed text-fg-muted">Deploy. Support. Troubleshoot. Improve.</p>
      </div>
      <div class="mt-10 grid gap-px overflow-hidden border border-line bg-surface sm:grid-cols-2 lg:grid-cols-3">
        <article class="bg-surface p-6">
          <p class="font-mono text-sm text-accent">01 / DATA SCIENCE PLATFORMS</p>
          <h3 class="mt-5 text-xl font-semibold text-fg">Deploy Posit Team anywhere</h3>
          <p class="mt-3 text-sm leading-relaxed text-fg-muted">
            Deploy and support Posit Team for data science.
          </p>
          <p class="mt-5 text-xs text-fg-muted">AWS · Azure · GCP · On premises</p>
        </article>
        <article class="bg-surface p-6">
          <p class="font-mono text-sm text-accent">02 / PLATFORM OPERATIONS</p>
          <h3 class="mt-5 text-xl font-semibold text-fg">Keep critical systems healthy</h3>
          <p class="mt-3 text-sm leading-relaxed text-fg-muted">
            Support cloud, Linux, Kubernetes, and automation.
          </p>
          <p class="mt-5 text-xs text-fg-muted">Reliable · secure · repeatable</p>
        </article>
        <article class="bg-surface p-6 sm:col-span-2 lg:col-span-1">
          <p class="font-mono text-sm text-accent">03 / ENTERPRISE SUPPORT</p>
          <h3 class="mt-5 text-xl font-semibold text-fg">Find the signal in the noise</h3>
          <p class="mt-3 text-sm leading-relaxed text-fg-muted">
            Troubleshoot enterprise applications and production issues.
          </p>
          <p class="mt-5 text-xs text-fg-muted">Diagnose · explain · improve</p>
        </article>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-surface py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Proof of practice</p>
          <h2 class="mt-2 text-2xl font-semibold text-fg">Certifications</h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-fg-muted">
          A practical blend of cloud architecture, secure operations, and container platforms.
        </p>
      </div>
      <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {certifications.map((cert, index) => (
          <li class="rounded-lg border border-line bg-surface px-4 py-3 text-sm text-fg">
            <span class="mr-3 font-mono text-accent/70">0{index + 1}</span>
            {cert}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
