---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import ProjectGrid from '../../components/projects/ProjectGrid.astro';

const projects = (await getCollection('projects', ({ data }) => data.status !== 'draft')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Projects"
  description="Case studies from cloud infrastructure, Linux and platform engineering work: the problem, the approach, the stack and what changed."
  ogImage="/og/projects.png"
>
  <Section>
    <Container size="wide">
      <Eyebrow prefix="$">ls ./projects</Eyebrow>
      <h1 class="text-h1 text-fg mt-3">Projects</h1>
      <p class="text-lead text-fg-muted mt-4 max-w-2xl">
        Real environments, written up the same way each time: the problem, the approach, the stack
        and what changed.
      </p>
      <ProjectGrid projects={projects} all={projects} />
    </Container>
  </Section>
</BaseLayout>
