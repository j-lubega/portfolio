---
/**
 * Design-system review page. Internal: noindex, excluded from the sitemap.
 * Renders every token and primitive twice, once per theme, by pinning
 * color-scheme on each panel (the tokens are light-dark() so nothing else is needed).
 * Contrast ratios are measured in the browser from computed colors.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Tag from '../components/ui/Tag.astro';
import StatusPill from '../components/ui/StatusPill.astro';
import Icon from '../components/ui/Icon.astro';
import Stat from '../components/ui/Stat.astro';

const colorTokens = [
  'canvas',
  'surface',
  'surface-raised',
  'line',
  'line-strong',
  'fg',
  'fg-muted',
  'fg-faint',
  'accent',
  'accent-fg',
  'accent-soft',
  'accent-hover',
  'ok',
  'warn',
  'danger',
  'code-bg',
  'code-fg',
  'scrim',
];

// Text-on-background pairs that must meet WCAG AA (4.5:1 body, 3:1 large).
const pairs: { fg: string; bg: string; large?: boolean; note?: string }[] = [
  { fg: 'fg', bg: 'canvas' },
  { fg: 'fg-muted', bg: 'canvas' },
  { fg: 'fg-faint', bg: 'canvas' },
  { fg: 'accent', bg: 'canvas' },
  { fg: 'ok', bg: 'canvas' },
  { fg: 'warn', bg: 'canvas' },
  { fg: 'danger', bg: 'canvas' },
  { fg: 'fg', bg: 'surface' },
  { fg: 'fg-muted', bg: 'surface' },
  { fg: 'fg-faint', bg: 'surface' },
  { fg: 'accent', bg: 'surface' },
  { fg: 'accent-fg', bg: 'accent', note: 'primary button' },
  { fg: 'accent-fg', bg: 'accent-hover', note: 'primary button hover' },
  { fg: 'fg', bg: 'accent-soft', note: 'tag on canvas' },
  { fg: 'accent', bg: 'accent-soft', note: 'ghost button hover' },
  { fg: 'code-fg', bg: 'code-bg', note: 'code block' },
  { fg: 'fg', bg: 'canvas', large: true, note: 'display heading' },
];

const themes = [
  { key: 'light', label: 'Light (daylight)' },
  { key: 'dark', label: 'Dark (night ops)' },
] as const;

const typeScale = [
  { cls: 'text-display', name: 'display', sample: 'Platforms that stay up.' },
  { cls: 'text-h1', name: 'h1', sample: 'Education and certifications' },
  { cls: 'text-h2', name: 'h2', sample: 'What I help teams do' },
  { cls: 'text-h3', name: 'h3', sample: 'Deploy Posit Team anywhere' },
  {
    cls: 'text-lead',
    name: 'lead',
    sample: 'I design, deploy, and support secure, scalable platforms across AWS and Azure.',
  },
  {
    cls: 'text-body',
    name: 'body',
    sample:
      'Terraform for repeatable cloud infrastructure, Ansible and shell automation for configuration, least-privilege access and auditable administrative paths.',
  },
  { cls: 'text-small', name: 'small', sample: 'Captions, footer text, helper copy.' },
  {
    cls: 'text-mono-label font-mono uppercase',
    name: 'mono-label',
    sample: '// platform operations',
  },
  {
    cls: 'text-mono-meta font-mono',
    name: 'mono-meta',
    sample: 'issued 2024-03 / expires 2027-03 / 60 min / $100',
  },
];

const icons = [
  'lucide:lightbulb',
  'lucide:terminal',
  'lucide:server',
  'lucide:cloud',
  'lucide:shield-check',
  'lucide:git-branch',
  'lucide:activity',
  'simple-icons:amazonwebservices',
  'simple-icons:kubernetes',
  'simple-icons:terraform',
  'simple-icons:ansible',
  'simple-icons:linux',
  'simple-icons:docker',
  'simple-icons:prometheus',
  'simple-icons:grafana',
  'simple-icons:posit',
];
---

<BaseLayout
  title="Design system"
  description="Internal review page for tokens, type and primitives."
  noindex
>
  <Section>
    <Container>
      <Eyebrow>internal</Eyebrow>
      <h1 class="text-h1 mt-3">Design system</h1>
      <p class="text-lead text-fg-muted mt-4 max-w-2xl">
        Every token and primitive, rendered in both themes side by side. The page follows the site
        theme for its own chrome; each panel below pins its own color-scheme. Contrast ratios are
        measured from computed colors when the page loads.
      </p>
    </Container>
  </Section>

  <Section tone="surface" labelledby="palette">
    <Container size="wide">
      <SectionHeader eyebrow="tokens" index="01" title="Palette and contrast" id="palette">
        Body text needs 4.5:1, large text 3:1. Cells that fail are outlined in the danger color.
      </SectionHeader>
      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        {themes.map((t) => (
          <div
            class="border-line bg-canvas text-fg rounded-lg border p-5 sm:p-6"
            style={`color-scheme: ${t.key}`}
            data-theme-panel={t.key}
          >
            <p class="text-mono-label text-fg-faint font-mono uppercase">{t.label}</p>
            <ul class="mt-4 grid grid-cols-3 gap-2 sm:grid-cols-6">
              {colorTokens.map((name) => (
                <li class="flex flex-col gap-1">
                  <span
                    class="border-line block h-10 rounded-sm border"
                    style={`background-color: var(--${name})`}
                    data-swatch={name}
                  />
                  <span class="text-fg-muted font-mono text-[11px] leading-tight">{name}</span>
                  <span
                    class="text-fg-faint font-mono text-[10px] leading-tight"
                    data-swatch-value
                  />
                </li>
              ))}
            </ul>
            <table class="mt-6 w-full border-collapse text-left">
              <thead>
                <tr class="text-mono-label text-fg-faint font-mono uppercase">
                  <th class="border-line border-b py-2 pr-2 font-medium">Pair</th>
                  <th class="border-line border-b py-2 pr-2 font-medium">Sample</th>
                  <th class="border-line border-b py-2 font-medium">Ratio</th>
                </tr>
              </thead>
              <tbody class="text-small">
                {pairs.map((p) => (
                  <tr>
                    <td class="border-line text-fg-muted border-b py-2 pr-2 font-mono text-xs">
                      {p.fg} / {p.bg}
                      {p.note && <span class="text-fg-faint block">{p.note}</span>}
                    </td>
                    <td class="border-line border-b py-2 pr-2">
                      <span
                        class:list={[
                          'inline-block rounded-xs px-2 py-1',
                          p.large ? 'text-2xl font-semibold' : 'text-sm',
                        ]}
                        style={`color: var(--${p.fg}); background-color: var(--${p.bg})`}
                        data-pair
                        data-large={p.large ? 'true' : undefined}
                      >
                        Aa 400+ servers
                      </span>
                    </td>
                    <td class="border-line border-b py-2 font-mono text-xs" data-ratio>
                      ...
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section labelledby="type">
    <Container>
      <SectionHeader eyebrow="tokens" index="02" title="Type scale" id="type">
        IBM Plex Sans for display and body, IBM Plex Mono for labels, metadata and code. Fluid
        sizes; the body steps to 17px at 1280px and wider.
      </SectionHeader>
      <ul class="border-line mt-10 divide-y divide-(--line) border-y">
        {typeScale.map((t) => (
          <li class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]">
            <span class="text-mono-meta text-fg-faint font-mono">{t.name}</span>
            <span class:list={[t.cls, 'text-fg']}>{t.sample}</span>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section tone="surface" labelledby="shape">
    <Container>
      <SectionHeader eyebrow="tokens" index="03" title="Radius, lines and elevation" id="shape">
        Sharp corners read as systems. Dark mode expresses elevation by surface tier, never by
        shadow; the shadow tokens dissolve to transparent there.
      </SectionHeader>
      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        {themes.map((t) => (
          <div
            class="border-line bg-canvas text-fg rounded-lg border p-6"
            style={`color-scheme: ${t.key}`}
          >
            <p class="text-mono-label text-fg-faint font-mono uppercase">{t.label}</p>
            <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
              {['xs', 'sm', 'md', 'lg'].map((r) => (
                <div class={`bg-surface border-line rounded-${r} border p-4`}>
                  <span class="text-mono-meta text-fg-muted font-mono">rounded-{r}</span>
                </div>
              ))}
            </div>
            <div class="mt-4 grid grid-cols-3 gap-4">
              {['1', '2', '3'].map((s) => (
                <div class={`bg-surface shadow-${s} border-line rounded-md border p-4`}>
                  <span class="text-mono-meta text-fg-muted font-mono">shadow-{s}</span>
                </div>
              ))}
            </div>
            <div class="mt-4 flex gap-4">
              <div class="border-line flex-1 rounded-md border p-4">
                <span class="text-mono-meta text-fg-muted font-mono">border-line</span>
              </div>
              <div class="border-line-strong flex-1 rounded-md border p-4">
                <span class="text-mono-meta text-fg-muted font-mono">border-line-strong</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section labelledby="primitives">
    <Container size="wide">
      <SectionHeader eyebrow="components" index="04" title="Primitives" id="primitives">
        Tab through this section: every interactive element shows the 2px accent ring.
      </SectionHeader>
      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        {themes.map((t) => (
          <div
            class="border-line bg-canvas text-fg flex flex-col gap-10 rounded-lg border p-5 sm:p-6"
            style={`color-scheme: ${t.key}`}
          >
            <p class="text-mono-label text-fg-faint font-mono uppercase">{t.label}</p>

            <div>
              <p class="text-mono-meta text-fg-faint mb-3 font-mono">Button: variants and sizes</p>
              <div class="flex flex-wrap items-center gap-3">
                <Button href="#primitives">Book a free 30-minute call</Button>
                <Button href="#primitives" variant="secondary">
                  See projects
                  <Icon name="lucide:arrow-right" size={16} />
                </Button>
                <Button variant="ghost">Reset to automatic</Button>
              </div>
              <div class="mt-3 flex flex-wrap items-center gap-3">
                <Button size="sm">Small</Button>
                <Button size="md" variant="secondary">
                  Medium
                </Button>
                <Button size="lg">Large</Button>
                <Button href="https://calendly.com/jimmylubegapro/30min" variant="secondary">
                  External link
                  <Icon name="lucide:arrow-up-right" size={16} />
                </Button>
                <Button disabled>Disabled</Button>
              </div>
            </div>

            <div>
              <p class="text-mono-meta text-fg-faint mb-3 font-mono">Eyebrow and SectionHeader</p>
              <SectionHeader eyebrow="what I do" index="02" title="Keep critical systems healthy">
                Support cloud, Linux, Kubernetes, and automation. Reliable, secure, repeatable.
              </SectionHeader>
            </div>

            <div>
              <p class="text-mono-meta text-fg-faint mb-3 font-mono">Card, Tag, StatusPill</p>
              <div class="grid gap-4 sm:grid-cols-2">
                <Card>
                  <StatusPill status="ok">completed</StatusPill>
                  <h3 class="text-h3 mt-4">Self-signed TLS for Posit Team</h3>
                  <p class="text-small text-fg-muted mt-2">
                    HTTPS across Connect, Workbench and Package Manager with proper SAN support.
                  </p>
                  <ul class="mt-4 flex flex-wrap gap-2">
                    <Tag element="li" icon="simple-icons:rockylinux">
                      Rocky Linux
                    </Tag>
                    <Tag element="li">OpenSSL</Tag>
                    <Tag element="li" icon="simple-icons:posit">
                      Posit Team
                    </Tag>
                  </ul>
                </Card>
                <Card element="a" href="#primitives" interactive>
                  <StatusPill status="neutral">ongoing</StatusPill>
                  <h3 class="text-h3 mt-4">Interactive card</h3>
                  <p class="text-small text-fg-muted mt-2">
                    The whole card is a link. Hover lifts the border; focus shows the ring.
                  </p>
                  <p class="text-mono-meta text-accent mt-4 font-mono">read case study</p>
                </Card>
              </div>
              <div class="mt-4 flex flex-wrap gap-2">
                <StatusPill status="ok">operational</StatusPill>
                <StatusPill status="warn">expires 2026-11</StatusPill>
                <StatusPill status="neutral">draft</StatusPill>
              </div>
            </div>

            <div>
              <p class="text-mono-meta text-fg-faint mb-3 font-mono">Stat</p>
              <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
                <Stat value="10+" label="years" />
                <Stat value="5" label="certifications" />
                <Stat value="400+" label="physical servers" />
                <Stat value="2,000+" label="virtual machines" />
              </div>
            </div>

            <div>
              <p class="text-mono-meta text-fg-faint mb-3 font-mono">Icon (lucide, simple-icons)</p>
              <div class="text-fg-muted flex flex-wrap gap-4">
                {icons.map((name) => (
                  <Icon name={name} size={22} label={name} />
                ))}
              </div>
            </div>

            <div>
              <p class="text-mono-meta text-fg-faint mb-3 font-mono">Prose (case study body)</p>
              <div class="prose">
                <h3>Phase 3: share the certificate via a dedicated group</h3>
                <p>
                  Each Posit product runs as its own service user and needs read access to the same
                  private key. Rather than changing ownership per product, a shared group avoids
                  breaking the others. See <a href="#primitives">the troubleshooting table</a>.
                </p>
                <pre><code>sudo groupadd -f posit-ssl
sudo usermod -aG posit-ssl rstudio-connect
sudo chmod 640 /etc/ssl/private/&lt;VM_HOSTNAME&gt;.key</code></pre>
                <p>
                  Permissions on both the key <strong>and its parent directory</strong> matter; run{' '}
                  <code>getenforce</code> to confirm the SELinux mode.
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>

<script>
  // Measure contrast from computed colors so the table reflects the real tokens.
  const lum = (r: number, g: number, b: number) => {
    const f = (v: number) => {
      v /= 255;
      return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
    };
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);
  };
  const parse = (s: string) => {
    const m = s.match(/[\d.]+/g)?.map(Number) ?? [0, 0, 0, 1];
    return { r: m[0] ?? 0, g: m[1] ?? 0, b: m[2] ?? 0, a: m[3] ?? 1 };
  };
  const over = (c: ReturnType<typeof parse>, bg: ReturnType<typeof parse>) => ({
    r: c.r * c.a + bg.r * (1 - c.a),
    g: c.g * c.a + bg.g * (1 - c.a),
    b: c.b * c.a + bg.b * (1 - c.a),
    a: 1,
  });

  const init = () => {
    for (const panel of document.querySelectorAll<HTMLElement>('[data-theme-panel]')) {
      const canvas = parse(getComputedStyle(panel).backgroundColor);
      panel.querySelectorAll<HTMLElement>('[data-swatch]').forEach((sw) => {
        const val = sw.nextElementSibling?.nextElementSibling;
        if (val) val.textContent = getComputedStyle(sw).backgroundColor.replace(/\s/g, '');
      });
      panel.querySelectorAll<HTMLElement>('[data-pair]').forEach((el) => {
        const cs = getComputedStyle(el);
        const bg = over(parse(cs.backgroundColor), canvas);
        const fg = over(parse(cs.color), bg);
        const l1 = lum(fg.r, fg.g, fg.b);
        const l2 = lum(bg.r, bg.g, bg.b);
        const ratio = (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
        const need = el.dataset.large ? 3 : 4.5;
        const cell = el.closest('tr')?.querySelector<HTMLElement>('[data-ratio]');
        if (!cell) return;
        cell.textContent = `${ratio.toFixed(2)}:1 ${ratio >= need ? 'pass' : 'FAIL'}`;
        cell.style.color = ratio >= need ? 'var(--ok)' : 'var(--danger)';
        if (ratio < need) el.style.outline = '2px solid var(--danger)';
      });
    }
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>
