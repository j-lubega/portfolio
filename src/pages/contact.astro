---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/site';
---

<BaseLayout
  title="Contact purenest360 llc Technical Consulting"
  description="Stay connected with purenest360 llc for practical technical consulting, Posit Team deployments, cloud infrastructure support, Linux operations, and enterprise application troubleshooting."
  keywords="contact purenest360 llc, technical consulting services, infrastructure support, Posit Team consultant, AWS Azure GCP consultant, Linux support, enterprise application troubleshooting, platform engineering"
>
  <section class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <div class="max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Stay connected</p>
      <h1 class="mt-5 text-4xl font-semibold tracking-tight text-fg sm:text-6xl">
        Good infrastructure starts with a good conversation.
      </h1>
      <p class="mt-6 text-xl leading-relaxed text-fg-muted">
        Connect with purenest360 llc when you need a clear technical path, steady platform support,
        or an experienced partner for a difficult production problem.
      </p>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-[1fr_0.8fr]">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">What you gain</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
          <article class="border-l border-accent/50 pl-5">
            <h2 class="text-lg font-semibold text-fg">Clear direction</h2>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">
              Turn a complex platform or infrastructure question into a practical next step.
            </p>
          </article>
          <article class="border-l border-accent/50 pl-5">
            <h2 class="text-lg font-semibold text-fg">Reliable delivery</h2>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">
              Deploy and support Posit Team, cloud, Linux, and enterprise systems with care.
            </p>
          </article>
          <article class="border-l border-accent/50 pl-5">
            <h2 class="text-lg font-semibold text-fg">Calmer operations</h2>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">
              Troubleshoot incidents, explain the root cause, and leave your team with a stronger
              system.
            </p>
          </article>
        </div>
      </div>

      <div class="border border-line-strong bg-surface p-6 sm:p-8">
        <h2 class="text-2xl font-semibold text-fg">Let's connect</h2>
        <p class="mt-3 text-sm leading-relaxed text-fg-muted">
          Reach out on LinkedIn or explore the work on GitHub. For a focused consulting
          conversation, book a time directly.
        </p>
        <div class="mt-8 flex flex-col gap-3">
          <a
            href={profile.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md bg-accent px-5 py-3 text-center text-sm font-semibold text-accent-fg transition hover:bg-accent-hover"
          >
            Connect on LinkedIn
          </a>
          <a
            href={profile.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md border border-line-strong px-5 py-3 text-center text-sm font-semibold text-fg transition hover:border-accent hover:text-accent"
          >
            View GitHub
          </a>
          <a
            href="/book"
            class="rounded-md border border-line-strong px-5 py-3 text-center text-sm font-semibold text-fg transition hover:border-accent hover:text-accent"
          >
            Book a technical call
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
