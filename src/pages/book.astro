---
/**
 * Deep-linkable Book a Call page: the same two option cards as Home, plus an inline
 * Calendly widget that switches between the two events.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import BookACall from '../components/home/BookACall.astro';
import { site } from '../data/site';

const options = [site.calendly.discovery, site.calendly.working];
const embed = (url: string) => `${url}?embed_type=Inline&hide_gdpr_banner=1`;
const price = (n: number) => (n === 0 ? 'free' : `$${n}`);
---

<BaseLayout
  title="Book a call"
  description="Book a free 30-minute discovery consultation or a 60-minute working session ($100) with Jimmy Lubega: cloud infrastructure, Linux, automation and Kubernetes."
  ogImage="/og/book.png"
>
  <Section class="pb-0 md:pb-0 lg:pb-0">
    <Container>
      <Eyebrow prefix="$">calendly --list</Eyebrow>
      <h1 class="text-h1 text-fg mt-3">Book a call</h1>
      <p class="text-lead text-fg-muted mt-4 max-w-2xl">
        Bring a hard problem. Pick the free discovery call for a first conversation, or a working
        session when you already know what needs solving.
      </p>
    </Container>
  </Section>

  <BookACall id="options" compact />

  <Section labelledby="schedule-title">
    <Container>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <Eyebrow index="03">schedule</Eyebrow>
          <h2 id="schedule-title" class="text-h2 text-fg mt-3">
            Pick a time
          </h2>
        </div>
        <div class="flex gap-2" role="group" aria-label="Choose an event type">
          {options.map((option, i) => (
            <button
              type="button"
              class:list={[
                'text-small border-line-strong inline-flex h-10 items-center gap-2 rounded-sm border px-4 font-medium transition-colors duration-(--dur-fast)',
                i === 0 ? 'bg-accent text-accent-fg border-accent' : 'text-fg-muted hover:text-fg',
              ]}
              data-schedule-option={option.id}
              data-url={embed(option.url)}
              data-title={`Calendly scheduling for the ${option.minutes}-minute ${option.title.toLowerCase()} (${price(option.price)})`}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {option.minutes} min · {price(option.price)}
            </button>
          ))}
        </div>
      </div>

      <div
        class="border-line bg-surface mt-8 overflow-hidden rounded-lg border p-2 sm:p-3"
        style="color-scheme: light"
      >
        <iframe
          id="schedule-frame"
          src={embed(options[0].url)}
          title={`Calendly scheduling for the ${options[0].minutes}-minute ${options[0].title.toLowerCase()} (${price(options[0].price)})`}
          class="h-[54rem] min-h-[42rem] w-full rounded-md border-0 bg-white"
          loading="lazy"
        ></iframe>
        <p class="text-small text-fg-muted border-line border-t px-3 py-3 text-center">
          Having trouble with the schedule?
          <a
            href={options[0].url}
            data-schedule-fallback
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent font-medium link-underline"
          >
            Open Calendly in a new tab
          </a>
        </p>
      </div>

      <aside class="border-line mt-10 border-t pt-5" aria-labelledby="privacy-title">
        <h2 id="privacy-title" class="text-mono-label text-fg-faint font-mono uppercase">
          Privacy and usage
        </h2>
        <p class="text-small text-fg-muted mt-3 max-w-3xl">
          Calendly processes the details needed to schedule and confirm your appointment under its
          own terms and privacy notice. Do not include passwords, private keys, credentials or
          confidential customer data in booking notes. For the best session, choose the right
          duration, use a work email, and have a short problem summary and any non-sensitive logs
          ready.
        </p>
      </aside>
    </Container>
  </Section>
</BaseLayout>

<script>
  const init = () => {
    const frame = document.getElementById('schedule-frame') as HTMLIFrameElement | null;
    const fallback = document.querySelector<HTMLAnchorElement>('[data-schedule-fallback]');
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-schedule-option]');
    if (!frame || buttons.length === 0) return;

    buttons.forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        const url = button.dataset.url ?? '';
        frame.src = url;
        frame.title = button.dataset.title ?? frame.title;
        if (fallback) fallback.href = url.split('?')[0];
        buttons.forEach((other) => {
          const active = other === button;
          other.setAttribute('aria-pressed', String(active));
          other.classList.toggle('bg-accent', active);
          other.classList.toggle('text-accent-fg', active);
          other.classList.toggle('border-accent', active);
          other.classList.toggle('text-fg-muted', !active);
        });
      });
    });
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>
