---
import BaseLayout from './BaseLayout.astro';

interface Frontmatter {
  title: string;
  description: string;
  status?: string;
  stack?: string[];
  heroImage?: string;
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const { title, description, status = 'Completed & Verified', stack = [], heroImage } = frontmatter;
---

<BaseLayout title={title} description={description}>
  <article>
    <header
      class="project-hero border-b border-white/10"
      style={heroImage ? `--project-hero-image: url('${heroImage}')` : undefined}
    >
      <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
        <a href="/projects" class="text-sm text-cyan-300 hover:text-white">&larr; Back to Projects</a>

        <div class="mt-8 max-w-3xl">
          <span class="inline-block rounded-full bg-emerald-300/15 px-3 py-1 text-xs font-semibold text-emerald-200">{status}</span>
          <h1 class="mt-5 text-4xl font-semibold tracking-tight text-white sm:text-6xl">{title}</h1>
          <p class="mt-5 text-lg leading-relaxed text-slate-200">{description}</p>
          {stack.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2">
              {stack.map((item) => <li class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-mono text-slate-100">{item}</li>)}
            </ul>
          )}
        </div>
      </div>
    </header>

    <div
      class="prose prose-invert prose-cyan mx-auto max-w-3xl px-6 py-16
        prose-headings:font-semibold prose-headings:tracking-tight
        prose-a:text-cyan-400 prose-code:text-cyan-300
        prose-pre:bg-slate-900 prose-pre:border prose-pre:border-slate-800
        prose-table:text-sm prose-th:text-slate-200 prose-td:text-slate-300"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
