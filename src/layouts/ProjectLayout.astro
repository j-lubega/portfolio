---
import BaseLayout from './BaseLayout.astro';

interface Frontmatter {
  title: string;
  description: string;
  status?: string;
  stack?: string[];
  heroImage?: string;
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const { title, description, status = 'Completed & Verified', stack = [], heroImage } = frontmatter;
---

<BaseLayout title={title} description={description}>
  <article>
    <header
      class="project-hero border-b border-line"
      style={heroImage ? `--project-hero-image: url('${heroImage}')` : undefined}
    >
      <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
        <a href="/projects" class="text-sm text-accent hover:text-fg">
          &larr; Back to Projects
        </a>

        <div class="mt-8 max-w-3xl">
          <span class="inline-block rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-ok">
            {status}
          </span>
          <h1 class="mt-5 text-4xl font-semibold tracking-tight text-fg sm:text-6xl">{title}</h1>
          <p class="mt-5 text-lg leading-relaxed text-fg">{description}</p>
          {stack.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2">
              {stack.map((item) => (
                <li class="rounded-full border border-line-strong bg-surface px-3 py-1 text-xs font-mono text-fg">
                  {item}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </header>

    <div class="prose mx-auto max-w-3xl px-6 py-16">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  /* Image-backed surface: theme-invariant dark so text over the photo is always light. */
  .project-hero {
    color-scheme: dark;
    background-image:
      linear-gradient(
        90deg,
        var(--scrim) 0%,
        color-mix(in srgb, var(--scrim) 78%, transparent) 48%,
        color-mix(in srgb, var(--scrim) 40%, transparent) 100%
      ),
      var(--project-hero-image, none);
    background-color: var(--canvas);
    background-position: center;
    background-size: cover;
  }
  @media (max-width: 639px) {
    .project-hero {
      background-position: 62% center;
    }
  }
</style>
