---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { transformSync } from 'esbuild';
import themeInitSource from '../scripts/theme-init.js?raw';

// Minified at build time so the inline bootstrap stays tiny; runs before first paint.
const themeInit = transformSync(themeInitSource, { minify: true }).code;

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  keywords?: string;
  /** Internal pages (the design review page) are kept out of search. */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-image.png',
  keywords = 'technical consultant, platform engineer, cloud infrastructure, Linux, AWS, Azure, Terraform, Kubernetes, DevOps, Posit',
  noindex = false,
} = Astro.props;
const siteName = `${site.name}, ${site.role}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: siteName,
  url: canonicalURL.toString(),
  description,
  areaServed: 'Worldwide',
  serviceType: [
    'Posit Team cloud deployment and support',
    'Enterprise application troubleshooting',
    'Cloud and on-premises platform engineering',
  ],
  knowsAbout: [
    'Posit Team',
    'AWS',
    'Microsoft Azure',
    'Google Cloud Platform',
    'Linux',
    'Kubernetes',
    'Terraform',
    'Ansible',
    'TLS',
    'Enterprise application support',
  ],
  provider: {
    '@type': 'Organization',
    name: 'purenest360 llc',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f8fa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b1220" />
    <script is:inline set:html={themeInit}></script>
    <noscript>
      <style>
        .theme-toggle {
          display: none;
        }
      </style>
    </noscript>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title} | {siteName}</title>
    <meta name="title" content={`${title} | ${siteName}`} />
    <meta name="description" content={description} />
    <meta name="author" content="Jimmy" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="keywords" content={keywords} />
    <meta name="category" content="Technical consulting and platform engineering" />
    <meta
      name="service"
      content="Posit Team deployment, cloud infrastructure, on-premises operations, and enterprise application support"
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteName} />

    <meta property="profile:first_name" content="Jimmy" />
    <meta property="profile:last_name" content="Lubega" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts: self-hosted through Astro's Fonts API (astro.config.mjs) -->
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />
  </head>
  <body class="bg-canvas text-fg antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-accent focus:text-accent-fg focus:px-4 focus:py-2 focus:rounded-sm focus:font-medium"
    >
      Skip to main content
    </a>
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
