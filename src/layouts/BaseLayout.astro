---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter, fade } from 'astro:transitions';
import { transformSync } from 'esbuild';
import themeInitSource from '../scripts/theme-init.js?raw';
import Seo from '../components/seo/Seo.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import SkipLink from '../components/shell/SkipLink.astro';
import Header from '../components/shell/Header.astro';
import Footer from '../components/shell/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Path or absolute URL for the social preview image. */
  ogImage?: string;
  ogImageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  /** Internal pages (the design review page) are kept out of search. */
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page, merged into the site @graph. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  type,
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd = [],
} = Astro.props;

// Minified at build time so the inline bootstrap stays tiny; runs before first paint.
const themeInit = transformSync(themeInitSource, { minify: true }).code;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f8fa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b1220" />
    <script is:inline set:html={themeInit}></script>
    <noscript>
      <style>
        .theme-toggle {
          display: none;
        }
      </style>
    </noscript>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <Seo
      title={title}
      description={description}
      image={ogImage}
      imageAlt={ogImageAlt}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      noindex={noindex}
    />
    <JsonLd nodes={jsonLd} />

    <!-- Fonts: self-hosted through Astro's Fonts API (astro.config.mjs) -->
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />

    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="bg-canvas text-fg flex min-h-dvh flex-col antialiased">
    <SkipLink />
    <Header />
    <main
      id="main-content"
      class="flex-1"
      transition:name="main"
      transition:animate={fade({ duration: '0.2s' })}
    >
      <slot />
    </main>
    <Footer />
    <!-- reveal.ts self-inits on load and on every astro:page-load; see src/scripts/reveal.ts -->
    <script>
      import '../scripts/reveal';
      import '../scripts/focus-after-nav';
      import '../scripts/count-up';
    </script>
  </body>
</html>
